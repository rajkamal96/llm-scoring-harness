# Needed for real scoring. Free key from https://aistudio.google.com/ . Without it the CLI uses the MOCK scorer.
GEMINI_API_KEY=

# Default is gemini-3.5-flash-lite (gemini-2.5-flash returned 404 for new API keys).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Only for tests against a local stub (see scripts/fake-gemini.ts). Leave unset otherwise.
# GEMINI_API_BASE=
